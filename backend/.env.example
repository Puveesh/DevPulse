# DevPulse Backend Environment Variables Example
# Set these in your runtime environment or .env file

DB_URL=jdbc:mysql://localhost:3306/devpulse?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root

# Cryptographically secure 256-bit+ signing key
JWT_SECRET=your-secure-base64-or-256-bit-jwt-secret-key-change-this-in-production
JWT_EXPIRATION_MS=86400000
JWT_COOKIE_SECURE=false

# Allowed origins for CORS (no wildcards with credentials)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

