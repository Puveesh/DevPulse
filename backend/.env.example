# DevPulse Backend Environment Variables Example
# Set these in your runtime environment or in Railway Service Variables

# Server Port (Railway automatically sets PORT)
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Database Configuration (supports individual variables or JDBC URL)
DB_HOST=mysql.railway.internal
DB_PORT=3306
DB_NAME=railway
DB_USERNAME=root
DB_PASSWORD=your_production_db_password

# Or full JDBC URL if preferred:
# DB_URL=jdbc:mysql://${DB_HOST}:${DB_PORT}/${DB_NAME}?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC

# Cryptographically secure 256-bit+ signing key
JWT_SECRET=your-production-256-bit-secure-base64-secret-key-replace-this
JWT_EXPIRATION_MS=86400000
JWT_COOKIE_SECURE=true
JWT_COOKIE_SAME_SITE=None

# Allowed origins for CORS (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,app://devpulse
