# DevPulse Monorepo Environment Configuration Example

# Database settings (MySQL)
MYSQL_DATABASE=devpulse
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=devpulse_user
MYSQL_PASSWORD=devpulse_secret
MYSQL_PORT=3306

# Backend configuration
DB_URL=jdbc:mysql://localhost:3306/devpulse?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root
JWT_SECRET=your-secure-base64-or-256-bit-jwt-secret-key-change-this-in-production
JWT_EXPIRATION_MS=86400000
JWT_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8081/api/v1/auth/google/callback
WEB_CALLBACK_URI=http://localhost:5173/auth/callback

# Frontend configuration
VITE_API_BASE_URL=/api/v1
