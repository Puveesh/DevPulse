# DevPulse Root Environment Configuration Example
# Copy to .env for local Docker Compose usage

# Database settings
MYSQL_DATABASE=devpulse
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=devpulse_user
MYSQL_PASSWORD=devpulse_secret
MYSQL_PORT=3306

# Backend configuration
DB_URL=jdbc:mysql://localhost:3306/devpulse?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root
JWT_SECRET=your-secure-base64-or-256-bit-jwt-secret-key-change-this-in-production
JWT_EXPIRATION_MS=86400000
JWT_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend configuration
VITE_API_URL=/api/v1

